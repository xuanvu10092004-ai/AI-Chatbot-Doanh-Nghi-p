# Máy chủ: 127.0.0.1. Máy thành viên: IP LAN của cùng một máy chủ MySQL.
# Cùng source Git không đồng bộ database cục bộ giữa các máy.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=honda_chatbot
DB_USER=admin_nt
DB_PASSWORD=choose-your-app-password
APP_DB_PASSWORD=choose-your-app-password
# Chỉ máy chủ cần ADMIN_DB_* để khởi tạo/migration. Không chia sẻ cho máy thành viên.
ADMIN_DB_USER=root
ADMIN_DB_PASSWORD=
CHATBOT_RO_USER=chatbot_ro
CHATBOT_RO_PASSWORD=choose-your-readonly-password
DEMO_ACCOUNT_PASSWORD=choose-your-demo-password
FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=dev
ALLOW_GUEST_CHAT=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
